# ==============================================================================
# NPM Runtime Configuration (.npmrc)
# ==============================================================================
# Non-obvious and deliberately chosen settings are annotated below to distinguish
# custom repository architecture requirements from standard template defaults.

# ------------------------------------------------------------------------------
# Dependency Resolution & Peer Dependencies (Deliberately Chosen)
# ------------------------------------------------------------------------------
# legacy-peer-deps=true:
# Starting in npm v7+, npm automatically installs peer dependencies and strictly
# errors on peer dependency version conflicts.
# In this monorepo, web3 ecosystem libraries (Soroban client, Stellar SDK) and
# frontend tooling have mismatched peer dependency ranges for React and TypeScript.
# Bypassing strict peer dependency resolution (reverting to npm v6 behavior) is
# deliberately required to prevent CI/CD failures during `npm ci` across both
# root and frontend workspaces without forcing artificial dependency pins.
legacy-peer-deps=true
